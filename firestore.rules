rules_version = '2';

    service cloud.firestore {
    match /databases/{database}/documents {
      function signedIn() {
        return request.auth != null;
      }

      function adminProfile() {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return signedIn() && (
          (profile.keys().hasAny(['role']) && profile.role in ['admin', 'administrator']) ||
          (profile.keys().hasAny(['isAdmin']) && profile.isAdmin == true)
        );
      }

      match /users/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || adminProfile());
        allow create: if signedIn()
          && request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['role', 'isAdmin']);
        allow update: if adminProfile() || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'fullName', 'name', 'email', 'photoURL', 'grade', 'xp', 'level', 'updatedAt'
          ])
        );
        allow delete: if adminProfile();

        match /subjects/{subjectId} {
          allow read, write: if signedIn() && request.auth.uid == userId;
        }
      }

      match /subjects/{subjectId} {
        allow read: if signedIn();
        allow write: if adminProfile();
      }

      match /questions/{questionId} {
        allow read: if signedIn();
        allow write: if adminProfile();
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
    }
    